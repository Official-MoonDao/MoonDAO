GROQ_API_KEY=
YOUTUBE_API_KEY=
CONVERT_KIT_API_KEY=
ALLOWED_YOUTUBE_CHANNEL_ID=

# Owner-authenticated caption download (the cookie-free transcript path).
# Create a Web application OAuth client in Google Cloud Console with
# http://localhost:8765 as an authorised redirect URI, then run
# `yarn oauth:setup` signed in as the @officialmoondao channel owner.
#
# IMPORTANT: set the OAuth consent screen to "In production". While it is in
# "Testing", Google expires the refresh token after 7 days.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# owner | captions | audio | auto (default). Pin one to debug a single path.
TRANSCRIPT_SOURCE=auto